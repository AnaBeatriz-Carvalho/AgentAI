# Exemplo de .env para o AgentAI
# Este projeto usa um LLM local via API OpenAI-compatível (ex.: LM Studio).

# Endpoint do servidor (padrão: localhost, se LM Studio estiver na mesma máquina).
# Se estiver em outra máquina na rede, use o IP específico (ex: http://192.168.15.2:1234/v1)
LOCAL_LLM_BASE_URL=http://localhost:1234/v1

# Em servidores locais, qualquer valor costuma funcionar (o LM Studio ignora),
# mas o SDK exige um campo api_key.
LOCAL_LLM_API_KEY=lm-studio

# Nome do modelo como exposto pelo servidor local.
# Recomendado: Mistral 7B Instruct
LOCAL_LLM_MODEL=mistralai/mistral-7b-instruct-v0.3

# --- Configuração RAG (busca semântica + citação de fonte) ---
# Modelo de embedding (PT-BR). Padrão leve (~470 MB). Para maior qualidade no domínio
# jurídico/parlamentar, troque por 'rufimelo/bert-large-portuguese-cased-sts' (~1.3 GB, +RAM).
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Tamanho do trecho (em palavras) e sobreposição entre trechos.
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=64
# Nº de trechos recuperados por pergunta.
RAG_TOP_K=5
# Onde persistir o índice FAISS e os metadados (não versionar; ver .gitignore).
RAG_INDEX_PATH=./vectorstore/discursos.faiss
RAG_META_PATH=./vectorstore/discursos_meta.parquet
