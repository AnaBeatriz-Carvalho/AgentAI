# Exemplo de .env para o AgentAI
# Este projeto usa um LLM local via API OpenAI-compatível (ex.: LM Studio).

# Endpoint do servidor (padrão: localhost, se LM Studio estiver na mesma máquina).
# Se estiver em outra máquina na rede, use o IP específico (ex: http://192.168.15.2:1234/v1)
LOCAL_LLM_BASE_URL=http://localhost:1234/v1

# Em servidores locais, qualquer valor costuma funcionar (o LM Studio ignora),
# mas o SDK exige um campo api_key.
LOCAL_LLM_API_KEY=lm-studio

# Nome do modelo como exposto pelo servidor local.
# Recomendado: Mistral 7B Instruct
LOCAL_LLM_MODEL=mistralai/mistral-7b-instruct-v0.3

# --- Avaliação comparativa de modelos (scripts/coletar_avaliacao.py) ---
# Quantização do modelo carregado, só para carimbar no CSV de coleta (ex.: Q4_K_M).
LOCAL_LLM_MODEL_QUANT=
# Seed fixa e temperatura baixa fixa usadas na avaliação (reprodutibilidade).
LLM_SEED=42
LLM_EVAL_TEMPERATURE=0.1
